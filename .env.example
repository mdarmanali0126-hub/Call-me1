# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=

# Backend Admin Security Key
ADMIN_API_KEY=

# Firebase Client Configuration (Optional in AI Studio preview, Required in Vercel production if firebase-applet-config.json is omitted)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
